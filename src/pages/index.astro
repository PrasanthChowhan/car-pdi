      <script>
        document.addEventListener('DOMContentLoaded', () => {
          const video = document.getElementById('demo-video');
          const overlay = document.getElementById('video-overlay');
          const startBtn = document.getElementById('hero-start-btn');
          
          if (video && overlay) {
            overlay.addEventListener('click', () => {
              video.play();
              overlay.style.opacity = '0';
              overlay.style.pointerEvents = 'none';
            });
            
            video.addEventListener('pause', () => {
              overlay.style.opacity = '1';
              overlay.style.pointerEvents = 'auto';
            });
            
            video.addEventListener('ended', () => {
              overlay.style.opacity = '1';
              overlay.style.pointerEvents = 'auto';
            });
          }

          if (startBtn) {
            startBtn.addEventListener('click', (e) => {
              e.preventDefault();
              const target = document.getElementById('setup-form-console');
              if (target) {
                target.scrollIntoView({ behavior: 'smooth' });
              }
              if (typeof window.gtag === 'function') {
                window.gtag('event', 'hero_start_click', {
                  'event_category': 'Engagement',
                  'event_label': 'Hero Start Button'
                });
              }
            });
          }

          const warningBtn = document.getElementById('hero-warning-btn');
          const scrollToSetupBtn = document.getElementById('scroll-to-setup-btn');
          const finalCtaScrollBtn = document.getElementById('final-cta-scroll-btn');
          const setupForm = document.getElementById('setup-form');

          if (warningBtn) {
            warningBtn.addEventListener('click', (e) => {
              e.preventDefault();
              const target = document.getElementById('founder-warning-section');
              if (target) {
                target.scrollIntoView({ behavior: 'smooth' });
              }
              if (typeof window.gtag === 'function') {
                window.gtag('event', 'hero_warning_click', {
                  'event_category': 'Engagement',
                  'event_label': 'Founder Warning Scroll'
                });
              }
            });
          }

          if (scrollToSetupBtn) {
            scrollToSetupBtn.addEventListener('click', (e) => {
              e.preventDefault();
              const target = document.getElementById('setup-form-console');
              if (target) {
                target.scrollIntoView({ behavior: 'smooth' });
              }
            });
          }

          if (finalCtaScrollBtn) {
            finalCtaScrollBtn.addEventListener('click', (e) => {
              e.preventDefault();
              const target = document.getElementById('setup-form-console');
              if (target) {
                target.scrollIntoView({ behavior: 'smooth' });
              }
              if (typeof window.gtag === 'function') {
                window.gtag('event', 'final_cta_click', {
                  'event_category': 'Engagement',
                  'event_label': 'Bottom Form Scroll'
                });
              }
            });
          }

          if (setupForm) {
            setupForm.addEventListener('submit', () => {
              if (typeof window.gtag === 'function') {
                window.gtag('event', 'inspection_start', {
                  'event_category': 'AppFlow',
                  'event_label': 'Setup Form Submit'
                });
              }
            });
          }

          // Interactive mock device functionality
          const previewItems = document.querySelectorAll('.interactive-preview-item');
          previewItems.forEach(item => {
            const checkBtn = item.querySelector('.preview-check-btn');
            const details = item.querySelector('.preview-details');

            if (checkBtn) {
              checkBtn.addEventListener('click', (e) => {
                e.stopPropagation(); // Avoid triggering card details click
                checkBtn.classList.toggle('passed');
                if (checkBtn.classList.contains('passed')) {
                  checkBtn.style.background = 'var(--color-semantic-success)';
                  checkBtn.style.color = '#fff';
                  checkBtn.style.borderColor = 'var(--color-semantic-success)';
                  if (details) details.style.display = 'none';
                  updateFlaggedCount();
                } else {
                  checkBtn.style.background = '#fff';
                  checkBtn.style.color = 'transparent';
                  checkBtn.style.borderColor = 'var(--color-hairline-strong)';
                  updateFlaggedCount();
                }
              });
            }

            item.addEventListener('click', () => {
              if (details) {
                const isHidden = details.style.display === 'none' || details.style.display === '';
                details.style.display = isHidden ? 'block' : 'none';
                item.style.borderColor = isHidden ? 'var(--color-primary)' : 'var(--color-hairline)';
                updateFlaggedCount();
              }
            });
          });

          function updateFlaggedCount() {
            const items = document.querySelectorAll('.interactive-preview-item');
            let flagged = 0;
            items.forEach(item => {
              const checkBtn = item.querySelector('.preview-check-btn');
              const details = item.querySelector('.preview-details');
              // If details are visible and checkBtn is not green (passed), count as flagged
              if (details && details.style.display === 'block' && checkBtn && !checkBtn.classList.contains('passed')) {
                flagged++;
              }
            });
            const flaggedLabel = document.getElementById('preview-flagged-count');
            if (flaggedLabel) {
              flaggedLabel.textContent = `${flagged} Defect${flagged !== 1 ? 's' : ''} Flagged`;
            }
          }

          const previewExportBtn = document.getElementById('preview-export-btn');
          const previewToast = document.getElementById('preview-success-toast');
          if (previewExportBtn && previewToast) {
            previewExportBtn.addEventListener('click', () => {
              previewToast.style.bottom = '16px';
              if (typeof window.gtag === 'function') {
                window.gtag('event', 'preview_pdf_export', {
                  'event_category': 'Engagement',
                  'event_label': 'Mock Device Export'
                });
              }
              setTimeout(() => {
                previewToast.style.bottom = '-60px';
              }, 3000);
            });
          }

          // Parallax Scroll Fallback for browsers without scroll-driven animations support
          if (!CSS.supports('(animation-timeline: view()) and (animation-range: entry)')) {
            const heroBg = document.querySelector('.hero-bg-picture');
            const checklistCard = document.querySelector('#setup-form-console .card');
            const heroSection = document.querySelector('.hero-banner');
            const checklistSection = document.querySelector('#setup-form-console');

            const observerOptions = { threshold: 0 };

            const observer = new IntersectionObserver((entries) => {
              entries.forEach(entry => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                } else {
                  entry.target.classList.remove('is-visible');
                }
              });
            }, observerOptions);

            if (heroSection) observer.observe(heroSection);
            if (checklistSection) observer.observe(checklistSection);

            const handleScroll = () => {
              const scrollY = window.scrollY;
              const windowHeight = window.innerHeight;

              // Hero background parallax
              if (heroSection && heroSection.classList.contains('is-visible') && heroBg) {
                const rect = heroSection.getBoundingClientRect();
                const top = rect.top + scrollY;
                const height = rect.height;
                const scrollPercent = Math.max(0, Math.min(1, (scrollY - (top - windowHeight)) / (height + windowHeight)));
                heroBg.style.transform = `translateY(${scrollPercent * 120}px)`;
              }

              // Checklist card parallax
              if (checklistSection && checklistSection.classList.contains('is-visible') && checklistCard) {
                const rect = checklistSection.getBoundingClientRect();
                const top = rect.top + scrollY;
                // From entry 0% to cover 50%
                const scrollStart = top - windowHeight;
                const scrollEnd = top - (windowHeight / 2);
                const scrollPercent = Math.max(0, Math.min(1, (scrollY - scrollStart) / (scrollEnd - scrollStart)));
                const translateY = 60 * (1 - scrollPercent);
                const opacity = 0.85 + 0.15 * scrollPercent;
                checklistCard.style.transform = `translateY(${translateY}px)`;
                checklistCard.style.opacity = opacity.toString();
              }
            };

            const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (!prefersReducedMotion) {
              let ticking = false;
              window.addEventListener('scroll', () => {
                if (!ticking) {
                  window.requestAnimationFrame(() => {
                    handleScroll();
                    ticking = false;
                  });
                  ticking = true;
                }
              });
              // Trigger once to position elements correctly initially
              handleScroll();
            }
          }
        });
      </script>
