        <details class="safeguards-accordion card" style="background: #ffffff; padding: 0; overflow: hidden; border: 1px solid var(--color-hairline);">
          <summary style="padding: 16px 20px; cursor: pointer; font-weight: 600; color: var(--color-ink); display: flex; align-items: center; justify-content: space-between; list-style: none;">
