---
import '../index.css';
import Header from '../components/common/Header.tsx';
import Footer from '../components/common/Footer.tsx';

// Normalize canonical URL: strip trailing slash except for the root path
let cleanedPath = Astro.url.pathname;
if (cleanedPath.length > 1 && cleanedPath.endsWith('/')) {
  cleanedPath = cleanedPath.slice(0, -1);
}
const canonicalUrl = new URL(cleanedPath, 'https://carpdi.online').toString();
---
<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-EC6KQNT9SQ"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-EC6KQNT9SQ');
  </script>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>PDI Assistant - Forensic-grade vehicle inspections</title>
  <meta name="description" content="Inspect your new car like a forensic expert. Use our guided, offline-capable pre-delivery inspection (PDI) checklist tool to find defects before taking delivery." />
  <link rel="canonical" href={canonicalUrl} />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <style>
    .split-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--spacing-xl);
    }
    @media (min-width: 900px) {
      .split-grid {
        grid-template-columns: 1fr 1fr;
      }
    }
    .info-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--spacing-xl);
      border-top: 1px solid var(--color-hairline);
      padding-top: var(--spacing-section);
    }
    @media (min-width: 768px) {
      .info-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }
  </style>
</head>
<body>
  <Header client:load />

  <main>
    <!-- Hero Band -->
    <section class="page-container" style="padding-top: var(--spacing-section); padding-bottom: var(--spacing-xl);">
      <div style="max-width: 800px; display: flex; flex-direction: column; gap: var(--spacing-md);">
        <h1 class="display-mega">Inspect Your New Car Like a Forensic Expert.</h1>
        <p class="display-md" style="color: var(--color-body);">Never take delivery of a defective car. A guided, offline assistant that helps you spot problems in plain English—no mechanical knowledge required—and generates a professional PDF report for the dealer.</p>
        <div style="display: flex; flex-wrap: wrap; gap: var(--spacing-md); margin-top: var(--spacing-sm); align-items: center;">
          <div style="display: flex; align-items: center; gap: var(--spacing-xs); color: var(--color-muted);" class="body-sm">
            <span class="material-symbols-outlined" style="font-size: 16px;">check_circle</span> 100% Offline Capable
          </div>
          <div style="display: flex; align-items: center; gap: var(--spacing-xs); color: var(--color-muted);" class="body-sm">
            <span class="material-symbols-outlined" style="font-size: 16px;">check_circle</span> Zero Data Collection
          </div>
          <div style="display: flex; align-items: center; gap: var(--spacing-xs); color: var(--color-muted);" class="body-sm">
            <span class="material-symbols-outlined" style="font-size: 16px;">check_circle</span> Instant PDF Export
          </div>
        </div>
      </div>
    </section>

    <!-- Split-Screen Console -->
    <section class="page-container" style="padding-bottom: var(--spacing-section);">
      <div class="split-grid">
        <!-- Left: Form -->
        <div class="card" style="padding: var(--spacing-xl);">
          <form id="setup-form" action="/setup" method="GET" style="display: flex; flex-direction: column; gap: var(--spacing-lg); text-align: left;">
            <div style="display: flex; flex-direction: column; gap: var(--spacing-md);">
              <div style="display: flex; flex-direction: column; gap: var(--spacing-xs);">
                <label for="make" class="title-sm" style="color: var(--color-ink);">Brand / Make</label>
                <input id="make" name="make" required placeholder="e.g. Tesla, Honda, Porsche" type="text" />
              </div>
              <div style="display: flex; flex-direction: column; gap: var(--spacing-xs);">
                <label for="model" class="title-sm" style="color: var(--color-ink);">Model Name</label>
                <input id="model" name="model" required placeholder="e.g. Model Y, Accord, Macan" type="text" />
              </div>
            </div>
            <div style="display: flex; flex-direction: column; gap: var(--spacing-xs);">
              <span class="title-sm" style="color: var(--color-ink);">Power Unit Architecture</span>
              <div class="segmented-control" id="power-unit-control">
                <button type="button" class="active" data-val="ice">Gasoline / Hybrid / ICE</button>
                <button type="button" class="" data-val="ev">⚡ Electric Vehicle (EV)</button>
                <input type="hidden" name="power_unit" id="power_unit" value="ice" />
              </div>
            </div>
            <div style="display: flex; margin-top: var(--spacing-base);">
              <button type="submit" class="button-primary" style="width: 100%; display: flex; gap: 10px; justify-content: center; height: 52px;">
                <span>Start Inspection</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
              </button>
            </div>
          </form>
          
          <script>
            document.addEventListener('DOMContentLoaded', () => {
              const buttons = document.querySelectorAll('#power-unit-control button');
              const hiddenInput = document.getElementById('power_unit');
              
              buttons.forEach(button => {
                button.addEventListener('click', () => {
                  buttons.forEach(b => b.classList.remove('active'));
                  button.classList.add('active');
                  hiddenInput.value = button.dataset.val;
                });
              });
            });
          </script>
        </div>

        <!-- Right: Deal-Breaker Warning Panel -->
        <div class="card" style="background-color: var(--color-surface-card); border: 1px solid var(--color-primary); display: flex; flex-direction: column; gap: var(--spacing-md);">
          <div>
            <h3 class="display-sm" style="color: var(--color-ink); display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
              <span style="font-size: 22px;">🚨</span> The 6 Golden Rules of PDI
            </h3>
            <p class="body-sm" style="color: var(--color-semantic-error); font-weight: 600; margin: 0;">
              Read these before signing any paperwork or making final payments.
            </p>
          </div>
          
          <div style="display: flex; flex-direction: column; gap: 14px; margin-top: var(--spacing-xs);">
            <p class="body-sm" style="color: var(--color-body); margin: 0; line-height: 1.5;">
              <strong>🚫 No PDI, No Purchase:</strong> Walk away if the dealer denies access to the stockyard or refuses a PDI. You have a legal right to inspect before registration.
            </p>
            <p class="body-sm" style="color: var(--color-body); margin: 0; line-height: 1.5;">
              <strong>💰 Hold Final Payment:</strong> Never pay the full amount or register the car until it passes this checklist. Only pay the initial booking deposit beforehand.
            </p>
            <p class="body-sm" style="color: var(--color-body); margin: 0; line-height: 1.5;">
              <strong>☀️ Daylight Only:</strong> Always inspect outdoors in natural light. Showroom spotlights are intentionally angled to hide scratches, paint defects, and repainted panels.
            </p>
            <p class="body-sm" style="color: var(--color-body); margin: 0; line-height: 1.5;">
              <strong>🔒 Test Every Feature:</strong> Ensure all screens, electronics, and sunroofs are unlocked and functional. Evasiveness or "locked" systems often hide underlying faults.
            </p>
            <p class="body-sm" style="color: var(--color-body); margin: 0; line-height: 1.5;">
              <strong>🆔 Verify VIN & Odometer:</strong> Match the physical chassis VIN (under the windshield or door pillar) with your invoice to prevent car-switching. Odometer must be under 50–100 km.
            </p>
            <p class="body-sm" style="color: var(--color-body); margin: 0; line-height: 1.5;">
              <strong>🛠️ Bring Your Toolkit:</strong> Pack a bright flashlight, a phone camera to log defects, a tyre pressure gauge, and a friend for a second set of eyes.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Story Section -->
    <section class="page-container" style="padding-bottom: var(--spacing-section);">
      <div class="card" style="border: 1px solid var(--color-primary); display: flex; flex-direction: column; gap: var(--spacing-sm);">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--spacing-xs);">
          <span style="font-size: 11px; color: var(--color-primary); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; background: rgba(245, 78, 0, 0.1); padding: 2px 8px; border-radius: var(--rounded-pill);">Featured Story</span>
          <span style="font-size: 11px; color: var(--color-muted); font-weight: 500;">My Story</span>
        </div>
        <h2 class="title-md" style="color: var(--color-ink); margin: var(--spacing-xxs) 0 0 0;">How a Dealership Tried to Scam Me (and How I Stopped Them)</h2>
        <p class="body-sm" style="color: var(--color-body); margin: 0; line-height: 1.6;">
          "The dealer tried to scam us in more than one way... I was looking to buy a car... when I went to inspect it on July 8th, all my excitement vanished. The car looked old and had already been driven for 167 km. The tires were 10 months old..."
        </p>
        <div style="margin-top: var(--spacing-xxs);">
          <a href="/stories/my-story" class="button-secondary" style="display: inline-flex; align-items: center; gap: 6px; text-decoration: none; padding: 8px 16px; font-size: 13px; font-weight: 600;">
            <span>Read Full Story</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>

  </main>
  <Footer client:load />
</body>
</html>
