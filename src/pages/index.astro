---
import '../index.css';
import Header from '../components/common/Header.tsx';
import Footer from '../components/common/Footer.tsx';

// Normalize canonical URL: strip trailing slash except for the root path
let cleanedPath = Astro.url.pathname;
if (cleanedPath.length > 1 && cleanedPath.endsWith('/')) {
  cleanedPath = cleanedPath.slice(0, -1);
}
const canonicalUrl = new URL(cleanedPath, 'https://carpdi.online').toString();
---
<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-EC6KQNT9SQ"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-EC6KQNT9SQ');
  </script>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>PDI Assistant - Forensic-grade vehicle inspections</title>
  <meta name="description" content="Inspect your new car like a forensic expert. Use our guided, offline-capable pre-delivery inspection (PDI) checklist tool to find defects before taking delivery." />
  <link rel="canonical" href={canonicalUrl} />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <style>
    .split-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--spacing-xl);
    }
    @media (min-width: 900px) {
      .split-grid {
        grid-template-columns: 1fr 1fr;
      }
    }
    
    /* Collapsible safeguards accordion */
    details.safeguards-accordion {
      transition: all 0.2s ease;
    }
    details.safeguards-accordion[open] summary .accordion-arrow {
      transform: rotate(180deg);
    }
    details.safeguards-accordion summary::-webkit-details-marker {
      display: none;
    }
    .accordion-arrow {
      transition: transform 0.2s ease;
      font-size: 10px;
    }

    /* How it works steps */
    .steps-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
      margin-top: var(--spacing-xl);
    }
    @media (min-width: 768px) {
      .steps-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (min-width: 1024px) {
      .steps-grid {
        grid-template-columns: repeat(4, 1fr);
      }
    }
    
    .step-card {
      background: var(--color-surface-card);
      border: 1px solid var(--color-hairline);
      border-radius: var(--rounded-lg);
      padding: var(--spacing-lg);
      display: flex;
      flex-direction: column;
      gap: var(--spacing-sm);
      text-align: left;
      position: relative;
      transition: all 0.25s ease;
    }
    .step-card:hover {
      border-color: var(--color-primary);
      transform: translateY(-2px);
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.03);
    }
    .step-number {
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 700;
      color: var(--color-primary);
      background: rgba(245, 78, 0, 0.08);
      padding: 3px 8px;
      border-radius: var(--rounded-pill);
      align-self: flex-start;
    }

    /* Features Grid */
    .features-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
      margin-top: var(--spacing-xl);
    }
    @media (min-width: 768px) {
      .features-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    
    .feature-card {
      background: var(--color-canvas-soft);
      border: 1px solid var(--color-hairline);
      border-radius: var(--rounded-lg);
      padding: var(--spacing-lg);
      display: flex;
      gap: var(--spacing-md);
      text-align: left;
      align-items: flex-start;
      transition: border-color 0.2s ease;
    }
    .feature-card:hover {
      border-color: var(--color-hairline-strong);
    }
    .feature-icon-wrapper {
      background: var(--color-surface-card);
      border: 1px solid var(--color-hairline-strong);
      border-radius: var(--rounded-md);
      padding: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 42px;
      height: 42px;
      flex-shrink: 0;
      color: var(--color-primary);
    }
    
    /* Video Play Button Hover Effect */
    .play-btn {
      transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.2s ease;
    }
    .video-container-wrapper:hover .play-btn {
      transform: scale(1.08);
      background-color: var(--color-primary-active);
    }
    #video-overlay {
      transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Hero Banner: Clean Split Narrative Redesign */
    .hero-banner {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      width: 100%;
      border: 1px solid var(--color-hairline-strong);
      border-radius: var(--rounded-lg);
      overflow: hidden;
      background: var(--color-surface-card); /* Clean white panel background */
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.02);
      min-height: 560px;
      box-sizing: border-box;
    }
    
    .hero-text-panel {
      padding: var(--spacing-xl) var(--spacing-xxl);
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: var(--spacing-md);
      text-align: left;
      z-index: 2;
    }
    
    .hero-image-panel {
      position: relative;
      width: 100%;
      height: 100%;
      overflow: hidden;
      z-index: 1;
    }
    
    .hero-bg-picture {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 125%; /* Extra height to allow scrolling space for parallax */
      pointer-events: none;
    }
    
    .hero-bg-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }

    @media (max-width: 900px) {
      .hero-banner {
        grid-template-columns: 1fr;
        min-height: auto;
      }
      .hero-image-panel {
        height: 280px;
        order: -1; /* Place image at the top on mobile so flow starts with the car */
      }
      .hero-text-panel {
        padding: var(--spacing-md);
      }
      .hero-bg-picture {
        height: 100%; /* No parallax height on mobile */
      }
    }

    /* CTA Button Styles */
    .cta-container {
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-sm);
      margin-top: var(--spacing-xs);
      align-items: center;
    }
    .cta-button-primary {
      display: inline-flex;
      align-items: center;
      gap: var(--spacing-xxs);
      background-color: var(--color-primary);
      color: #fff !important;
      padding: 12px 24px;
      border-radius: var(--rounded-md);
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      transition: background-color 0.2s ease, transform 0.2s ease;
    }
    .cta-button-primary:hover {
      background-color: var(--color-primary-active);
      transform: translateY(-1px);
    }
    .cta-button-primary:active {
      transform: translateY(1px);
    }
    
    .cta-button-secondary {
      display: inline-flex;
      align-items: center;
      gap: var(--spacing-xxs);
      background-color: transparent;
      color: var(--color-ink) !important;
      border: 1px solid var(--color-hairline-strong);
      padding: 12px 24px;
      border-radius: var(--rounded-md);
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
    }
    .cta-button-secondary:hover {
      background-color: rgba(38, 37, 30, 0.04);
      border-color: var(--color-ink);
      transform: translateY(-1px);
    }
    .cta-button-secondary:active {
      transform: translateY(1px);
    }

    /* Scroll-driven Parallax animations */
    @supports ((animation-timeline: view()) and (animation-range: entry)) {
      .hero-banner {
        view-timeline: --hero-timeline;
      }
      .hero-bg-picture {
        animation: hero-bg-scroll linear both;
        animation-timeline: --hero-timeline;
        animation-range: exit 0% exit 100%;
      }
      
      #setup-form-console {
        view-timeline: --checklist-timeline;
      }
      #setup-form-console .card {
        animation: checklist-scroll linear both;
        animation-timeline: --checklist-timeline;
        animation-range: entry 0% cover 50%;
      }
    }

    @keyframes hero-bg-scroll {
      from {
        transform: translateY(0);
      }
      to {
        transform: translateY(120px);
      }
    }

    @keyframes checklist-scroll {
      from {
        transform: translateY(60px);
        opacity: 0.85;
      }
      to {
        transform: translateY(0);
        opacity: 1;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .hero-bg-picture, #setup-form-console .card {
        animation: none !important;
        transform: none !important;
        opacity: 1 !important;
      }
    }

    /* Mockup device utility helpers to align with design tokens */
    .mock-tagline {
      font-size: 10px;
      font-weight: 700;
      color: var(--color-primary);
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }
    .mock-text-xs {
      font-size: 10px;
    }
    .mock-text-sm {
      font-size: 11px;
    }
    .mock-text-md {
      font-size: 12.5px;
    }
    .mock-icon-sm {
      font-size: 20px !important;
    }
    .mock-icon-md {
      font-size: 24px !important;
    }
    .mock-icon-lg {
      font-size: 38px !important;
    }
    
    /* Touch target expansion for mobile checkmarks */
    .preview-check-btn {
      position: relative;
    }
    .preview-check-btn::after {
      content: '';
      position: absolute;
      top: -12px;
      left: -12px;
      right: -12px;
      bottom: -12px;
    }
  </style>
</head>
<body>
  <Header client:load />

  <main>
    <!-- Hero Section -->
    <section class="page-container" style="padding-top: var(--spacing-section); padding-bottom: var(--spacing-xl);">
      <div class="hero-banner">
        <!-- Left Column: Clean Typography Panel -->
        <div class="hero-text-panel">

          <h1 class="display-mega" style="margin: 0; color: var(--color-ink); font-weight: 700;">Don't Let the Dealership Hand You a Damaged Car.</h1>
          <p class="body-md" style="color: var(--color-body); margin: 0; line-height: 1.6;">Inspect your new vehicle before signing. Catch transport damage, demo mileage, repainted panels, and missing accessories while the dealer is still responsible.</p>
          
          <div style="display: flex; flex-wrap: wrap; gap: var(--spacing-md); margin-top: var(--spacing-xs); align-items: center;">
            <div style="display: flex; align-items: center; gap: var(--spacing-xxs); color: var(--color-muted);" class="body-sm">
              <span style="color: var(--color-semantic-success); font-weight: bold; font-size: 14px;">✓</span> Works Offline
            </div>
            <div style="display: flex; align-items: center; gap: var(--spacing-xxs); color: var(--color-muted);" class="body-sm">
              <span style="color: var(--color-semantic-success); font-weight: bold; font-size: 14px;">✓</span> No Account Required
            </div>
            <div style="display: flex; align-items: center; gap: var(--spacing-xxs); color: var(--color-muted);" class="body-sm">
              <span style="color: var(--color-semantic-success); font-weight: bold; font-size: 14px;">✓</span> Dealer-Ready PDF
            </div>
          </div>
          
          <div class="cta-container">
            <button id="hero-start-btn" class="cta-button-primary" style="cursor: pointer; border: none; font-family: inherit;">
              <span>Start Free Inspection</span>
              <span class="material-symbols-outlined" style="font-size: 18px;">arrow_forward</span>
            </button>
            <button id="hero-warning-btn" class="cta-button-secondary" style="cursor: pointer; border: 1px solid var(--color-hairline-strong); font-family: inherit;">
              <span>Why I Built This</span>
              <span class="material-symbols-outlined" style="font-size: 18px;">info</span>
            </button>
          </div>
        </div>

        <!-- Right Column: Unobscured Image Panel -->
        <div class="hero-image-panel">
          <picture class="hero-bg-picture">
            <source srcset="/modern_dealership_delivery.avif" type="image/avif" />
            <source srcset="/modern_dealership_delivery.webp" type="image/webp" />
            <img src="/modern_dealership_delivery.jpg" alt="Modern car dealership showroom ready for delivery" class="hero-bg-image" />
          </picture>
        </div>
      </div>
    </section>

    <!-- Delivery Day Risks Section -->
    <section class="page-container" style="padding-bottom: var(--spacing-section);">
      <div style="max-width: 800px; margin: 0 auto; text-align: center; margin-bottom: var(--spacing-xl);">
        <span class="caption-uppercase" style="color: var(--color-primary); display: block; margin-bottom: var(--spacing-xs);">The Delivery Day Trap</span>
        <h2 class="display-lg" style="margin-bottom: var(--spacing-xs); color: var(--color-ink);">Why You Cannot Just Trust the Dealership</h2>
        <p class="body-md" style="color: var(--color-body); max-width: 600px; margin: 0 auto;">Once a vehicle is registered in your name with the government RTO, it is legally yours. Rejecting a defective car post-registration is nearly impossible. Here are the hidden risks you face at the stockyard:</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--spacing-lg); max-width: 1000px; margin: 0 auto;">
        <div class="card" style="display: flex; flex-direction: column; gap: var(--spacing-sm); border-top: 3px solid var(--color-semantic-error); padding: var(--spacing-lg);">
          <div class="display-sm" style="color: var(--color-semantic-error); font-weight: 600; display: flex; align-items: center; gap: 8px;">
            <span class="material-symbols-outlined mock-icon-md">format_paint</span> Panel Repaints
          </div>
          <h4 class="title-sm" style="margin: 0; color: var(--color-ink);">Transit Scratches & Resprays</h4>
          <p class="body-sm" style="color: var(--color-body); margin: 0; line-height: 1.6;">Cars suffer scratches during long shipping transit. Dealers routinely respray body panels in-house before delivery without registering it on records or informing you.</p>
        </div>

        <div class="card" style="display: flex; flex-direction: column; gap: var(--spacing-sm); border-top: 3px solid var(--color-primary); padding: var(--spacing-lg);">
          <div class="display-sm" style="color: var(--color-primary); font-weight: 600; display: flex; align-items: center; gap: 8px;">
            <span class="material-symbols-outlined mock-icon-md">tire_repair</span> Old Stock & Rot
          </div>
          <h4 class="title-sm" style="margin: 0; color: var(--color-ink);">Months sitting in Stockyards</h4>
          <p class="body-sm" style="color: var(--color-body); margin: 0; line-height: 1.6;">Vehicles sit in dusty, open yards for up to 9 months. This leads to early battery drainage, rust underneath the frame, and rubber dry-rot on tyres that are sold to you as fresh.</p>
        </div>

        <div class="card" style="display: flex; flex-direction: column; gap: var(--spacing-sm); border-top: 3px solid var(--color-muted); padding: var(--spacing-lg);">
          <div class="display-sm" style="color: var(--color-muted); font-weight: 600; display: flex; align-items: center; gap: 8px;">
            <span class="material-symbols-outlined mock-icon-md">speed</span> Odometer Rollbacks
          </div>
          <h4 class="title-sm" style="margin: 0; color: var(--color-ink);">Demo & Test Drive Abuse</h4>
          <p class="body-sm" style="color: var(--color-body); margin: 0; line-height: 1.6;">Dealers sometimes disconnect odometer fuses to use new stock as client test-drive cars. You might receive a heavily abused vehicle polished to look like it has only run 15 km.</p>
        </div>
      </div>
    </section>

    <!-- Founder Story Section -->
    <section id="founder-warning-section" class="page-container" style="border-top: 1px solid var(--color-hairline); padding-top: var(--spacing-section); padding-bottom: var(--spacing-section); background: var(--color-canvas-soft);">
      <div style="max-width: 800px; margin: 0 auto; display: grid; grid-template-columns: 1fr; gap: var(--spacing-xl); align-items: center;">
        <div class="card" style="border: 1px solid var(--color-primary); background: #ffffff; padding: var(--spacing-xl); border-radius: var(--rounded-lg); position: relative;">
          <div style="position: absolute; top: -14px; left: 24px; background: var(--color-primary); color: #fff; font-size: 11px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase; padding: 3px 10px; border-radius: var(--rounded-pill);">
            Real Experience Warning
          </div>
          
          <h3 class="display-sm" style="color: var(--color-ink); margin-bottom: var(--spacing-sm); font-weight: 600;">"They Tried to Sell Me a 167 km Demo Car."</h3>
          
          <div style="display: flex; flex-direction: column; gap: var(--spacing-md); color: var(--color-body); line-height: 1.65;">
            <p style="margin: 0;">
              When I went to take delivery of my new car, I brought a strict inspection checklist. Under showroom lights, everything looked perfect. But when we went to inspect the car in the open stockyard, the reality became clear: <strong>the car was already driven for 167 km, had been sitting for 6 months, and the tyres were 10 months old.</strong>
            </p>
            <p style="margin: 0;">
              Because we performed a complete physical PDI <em>before</em> signing the RTO registration, we successfully rejected the car and forced the dealer to swap it for a fresh 21 km car directly from the factory.
            </p>
            <p style="margin: 0; font-weight: 600; color: var(--color-ink);">
              I built PDI Assistant to give every car buyer the exact checklists, tools, and decoders needed to find these problems and stand up to dealerships.
            </p>
          </div>

          <div style="margin-top: var(--spacing-md); display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--color-hairline-soft); padding-top: var(--spacing-md); flex-wrap: wrap; gap: var(--spacing-sm);">
            <div style="display: flex; align-items: center; gap: var(--spacing-xs);">
              <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--color-surface-strong); display: flex; align-items: center; justify-content: center; font-weight: bold; color: var(--color-primary);">PC</div>
              <div>
                <div style="font-weight: 600; color: var(--color-ink); font-size: 14px;">Prasanth Chowhan</div>
                <div class="caption" style="color: var(--color-muted);">Creator of PDI Assistant</div>
              </div>
            </div>
            <a href="/stories/my-story" class="cta-button-secondary" style="padding: 8px 16px; font-size: 13px; font-weight: 600; border-radius: var(--rounded-md); text-decoration: none;">
              <span>Read the Full Account</span>
              <span class="material-symbols-outlined" style="font-size: 16px;">arrow_forward</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Product Preview Section -->
    <section class="page-container" style="border-top: 1px solid var(--color-hairline); padding-top: var(--spacing-section); padding-bottom: var(--spacing-section);">
      <div style="max-width: 800px; margin: 0 auto; text-align: center; margin-bottom: var(--spacing-xl);">
        <span class="caption-uppercase" style="color: var(--color-primary); display: block; margin-bottom: var(--spacing-xs);">Product Walkthrough</span>
        <h2 class="display-lg" style="margin-bottom: var(--spacing-xs); color: var(--color-ink);">Test Drive PDI Assistant Right Now</h2>
        <p class="body-md" style="color: var(--color-body); max-width: 600px; margin: 0 auto;">Click on the checkpoints inside our interactive mock device below to see how easy it is to inspect your car, flag flaws, and log notes offline.</p>
      </div>

      <div class="split-grid" style="max-width: 960px; margin: 0 auto; gap: var(--spacing-xl);">
        <!-- Interactive Device Frame -->
        <div style="display: flex; justify-content: center; align-items: center;">
          <div class="card" style="width: 100%; max-width: 380px; height: 500px; border: 10px solid var(--color-ink); border-radius: 40px; padding: 20px 16px; display: flex; flex-direction: column; gap: 12px; background: var(--color-canvas); box-shadow: 0 30px 60px rgba(38,37,30,0.12); position: relative; overflow: hidden; box-sizing: border-box;">
            <!-- Speaker Grill -->
            <div style="position: absolute; top: 6px; left: 50%; transform: translateX(-50%); width: 60px; height: 8px; background: var(--color-ink); border-radius: 4px; z-index: 10;"></div>
            
            <!-- App Header -->
            <div style="border-bottom: 1px solid var(--color-hairline-strong); padding-bottom: 8px; margin-top: 4px; display: flex; justify-content: space-between; align-items: center;">
              <div>
                <span class="mock-tagline">PDI Companion</span>
                <h4 style="font-size: 14px; font-weight: 600; margin: 0; color: var(--color-ink);">Tesla Model Y PDI</h4>
              </div>
              <div class="mock-text-xs" style="background: rgba(31, 138, 101, 0.1); color: var(--color-semantic-success); font-weight: bold; padding: 2px 6px; border-radius: 4px;">
                100% Offline
              </div>
            </div>

            <!-- Scrollable Checklist Frame -->
            <div style="flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; padding-right: 4px; box-sizing: border-box;" class="no-scrollbar">
              
              <!-- Checklist Item 1 -->
              <div class="card interactive-preview-item" id="preview-item-1" style="padding: 12px; border-radius: var(--rounded-md); display: flex; flex-direction: column; gap: 6px; cursor: pointer; transition: all 0.2s; background: var(--color-surface-card); border: 1px solid var(--color-hairline); box-sizing: border-box;">
                <div style="display: flex; align-items: flex-start; gap: 10px;">
                  <button class="preview-check-btn mock-text-sm" aria-label="Mark checkpoint as passed" style="width: 20px; height: 20px; min-width: 20px; min-height: 20px; border-radius: 50%; border: 2px solid var(--color-hairline-strong); display: flex; align-items: center; justify-content: center; color: transparent; background: var(--color-surface-card); cursor: pointer; padding: 0;">✔</button>
                  <div style="flex: 1;">
                    <div class="mock-text-md" style="font-weight: 600; color: var(--color-ink);">Check Mileage Meter (Odometer)</div>
                    <div class="mock-text-sm" style="color: var(--color-body); margin-top: 2px;">Must be under 50 km, definitely under 100 km.</div>
                  </div>
                </div>
                <div class="preview-details" style="display: none; border-top: 1px dashed var(--color-hairline-strong); padding-top: 8px; margin-top: 4px;">
                  <div class="mock-text-sm" style="color: var(--color-semantic-error); font-weight: 600; margin-bottom: 4px;">❌ Odo reads 167 km! (Test-drive candidate)</div>
                  <textarea placeholder="Write defect details here..." class="mock-text-sm" style="min-height: 40px; padding: 4px 8px; margin-bottom: 6px; border-radius: 4px; border: 1px solid var(--color-hairline-strong); background: var(--color-canvas-soft); width: 100%; box-sizing: border-box;" readonly>Found odo reads 167 km and tyre build date is old.</textarea>
                  <div style="display: flex; gap: 6px; align-items: center;">
                    <div class="mock-text-xs" style="width: 24px; height: 24px; border-radius: 4px; background: var(--color-surface-strong); display: flex; align-items: center; justify-content: center;">📷</div>
                    <span class="mock-text-xs" style="color: var(--color-muted);">odo_167km_photo.jpg attached</span>
                  </div>
                </div>
              </div>

              <!-- Checklist Item 2 -->
