---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact Us — Car PDI Checklist" description="Get in touch with the Car PDI Checklist team for support, feedback, or dealership stories.">
  <div style="text-align: center; margin-bottom: var(--spacing-xl);">
    <h1 class="display-lg" style="margin-bottom: var(--spacing-xs);">Contact Us</h1>
    <p class="body-md" style="color: var(--color-muted); max-width: 480px; margin: 0 auto;">We'd love to hear from you.</p>
  </div>

  <div class="card" style="display: flex; flex-direction: column; gap: var(--spacing-md);">
    <p class="body-md" style="margin: 0;">We are constantly working to make the <strong>Car PDI Checklist</strong> the most reliable tool for new car buyers in India.</p>
    
    <h2 class="title-md">How Can We Help?</h2>
    <ul class="body-md" style="margin: 0; padding-left: var(--spacing-lg); color: var(--color-body); display: flex; flex-direction: column; gap: 8px;">
      <li><strong>Missing a Checklist Item?</strong> If you think we missed a critical inspection point for a specific car or EV, let us know!</li>
      <li><strong>Dealership Stories:</strong> Did our tool help you catch a major defect before delivery? We'd love to hear your success story.</li>
      <li><strong>Bug Reports:</strong> If you face any issues generating your PDF or using the app offline at the stockyard, please report it so we can fix it immediately.</li>
    </ul>

    <h2 class="title-md" style="margin-top: var(--spacing-sm);">Get in Touch</h2>
    <p class="body-md" style="margin: 0;">You can reach our team directly at:</p>
    <a href="mailto:support@pdiassistant.com" class="button-primary" style="text-decoration: none; width: fit-content; margin-top: 4px;">
      Email: support@pdiassistant.com
    </a>
    
    <p class="body-md" style="margin: 0; margin-top: var(--spacing-md); font-size: 14px; color: var(--color-muted);">
      Note: We are a small team of auto-enthusiasts, but we try to reply to all queries within 24-48 hours.
    </p>
  </div>
</Layout>
