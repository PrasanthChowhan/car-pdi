---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const stories = await getCollection('stories');
  return stories.map((story) => ({
    params: { slug: story.id },
    props: { story },
  }));
}

const { story } = Astro.props;
const { Content } = await render(story);

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};
---

<Layout title={`${story.data.title} — Car PDI Checklist`} description={story.data.excerpt || "Read this real-world car buyer pre-delivery inspection story."}>
  {/* Back button */}
  <div style="margin-bottom: var(--spacing-lg);">
    <a href="/stories" class="back-link" style="display: inline-flex; align-items: center; gap: var(--spacing-xxs); color: var(--color-muted); text-decoration: none; font-size: 14px; font-weight: 500; transition: color 0.2s ease;">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m15 18-6-6 6-6"></path>
      </svg>
      <span>Back to Stories</span>
    </a>
  </div>

  <article class="card" style="display: flex; flex-direction: column; gap: var(--spacing-md); padding: var(--spacing-xl);">
    <header style="border-bottom: 1px solid var(--color-hairline); padding-bottom: var(--spacing-md);">
      {story.data.featured && (
        <span class="featured-badge" style="margin-bottom: var(--spacing-xs); display: inline-block;">
          Featured Story
        </span>
      )}
      <h1 class="display-lg" style="margin-top: 0; margin-bottom: var(--spacing-xs); font-weight: 600; line-height: 1.25; color: var(--color-ink);">
        {story.data.title}
      </h1>
      <div style="color: var(--color-muted); font-size: 13px; font-weight: 500;">
        Published on {formatDate(story.data.date)} &bull; {story.data.author.toLowerCase() === 'my personal story' ? story.data.author : `By ${story.data.author}`}
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>

    {/* Post-article Call To Action */}
    <footer style="border-top: 1px solid var(--color-hairline); padding-top: var(--spacing-lg); margin-top: var(--spacing-md); display: flex; flex-direction: column; gap: var(--spacing-sm); align-items: center; text-align: center;">
      <h3 class="title-md" style="color: var(--color-ink); margin: 0;">Taking Delivery of a New Car Soon?</h3>
      <p class="body-sm" style="color: var(--color-body); max-width: 480px; margin: 0;">
        Don't let a dealership rush you. Run a comprehensive, forensic-grade pre-delivery inspection using our free interactive tool.
      </p>
      <div style="margin-top: var(--spacing-xxs);">
        <a href="/" class="button-primary" style="display: inline-block; text-decoration: none; padding: 10px 24px;">
          Start Your Checklist
        </a>
      </div>
    </footer>
  </article>
</Layout>

<style>
  .back-link:hover {
    color: var(--color-primary) !important;
  }
  
  .featured-badge {
    background-color: rgba(245, 78, 0, 0.1);
    color: var(--color-primary);
    padding: 2px 8px;
    border-radius: var(--rounded-pill);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
</style>
